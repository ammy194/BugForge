# ==============================================================================
# BugForge Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ONLY (Set in Render Dashboard / production server - NEVER send to browser)
# ------------------------------------------------------------------------------
PORT=10000
NODE_ENV=production
CLIENT_URL=https://bug-forge-frontend.vercel.app
FRONTEND_URL=https://bug-forge-frontend.vercel.app

# Supabase Server-Side (PostgreSQL, Auth, RLS, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Grok AI Configuration (Server-Side Only)
GROK_API_KEY=xai-your-grok-api-key
GROK_API_URL=https://api.x.ai/v1

# GitHub Integration (Server-Side Only)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_TOKEN=ghp_your_personal_access_token

# ------------------------------------------------------------------------------
# FRONTEND SAFE (Set in Vercel Dashboard / client build - Safe for browser)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://bugforge-backend.onrender.com/api/v1
VITE_API_URL=https://bugforge-backend.onrender.com/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
