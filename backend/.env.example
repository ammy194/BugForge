# ==============================================================================
# BugForge Backend Environment Variables (Render / Server-Side)
# ==============================================================================

PORT=10000
NODE_ENV=production
CLIENT_URL=https://bugforge-app.vercel.app
FRONTEND_URL=https://bugforge-app.vercel.app

# Supabase Server-Side (PostgreSQL, Auth, RLS, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Grok AI Configuration (Server-Side Only - Never exposed to frontend)
GROK_API_KEY=xai-your-grok-api-key
GROK_API_URL=https://api.x.ai/v1

# GitHub Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_TOKEN=ghp_your_personal_access_token
